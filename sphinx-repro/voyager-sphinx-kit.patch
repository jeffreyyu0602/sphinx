+++ b/sphinx/firmware/rebuild.sh
@@ -0,0 +1,109 @@
+#!/bin/bash
+# Rebuild the Sphinx chip firmware from the recorded commits, without
+# run_voyager.py (its --build-only still builds the simv, which in a fresh
+# tree means elaboration and Catapult HLS).
+#
+#   rebuild.sh compile <net>               params -> $VOY/test/compiler/networks
+#   rebuild.sh emit <graded|power> <net>   emit + link -> $VOY/test/soc/firmware
+#
+# Lives at generators/voyager/sphinx/firmware/ in a superrepo checkout of
+# 473ff85e with generators/voyager at 0733cd8 and voyager-compiler at
+# 34ceff2 (SPHINX_REPRO.md). ENV_SH is the repo env (conda, riscv tools).
+
+WT=${WT:-$(cd "$(dirname "$0")/../../../.." && pwd)}
+BUILD_DIR=${BUILD_DIR:-$WT/generators/voyager/build/sphinx-repro}
+ENV_SH=${ENV_SH:-$WT/env.sh}
+VOY=$WT/generators/voyager
+CFG=MXNF4/64x64_512x576x256_true_true_true
+
+# EDA modules (Catapult g++ and headers, no HLS run) and the conda env
+# (protobuf, torch, riscv64-unknown-elf 13.2.0).
+eval `modulecmd bash load base catapult/2024.2_2 vcs/T-2022.06-SP2 verdi/S-2021.09-SP1 dc_shell/U-2022.12-SP1`
+export VG_GNU_PACKAGE=/cad/synopsys/vcs_gnu_package/S-2021.09/gnu_9/linux
+source $VG_GNU_PACKAGE/source_me.sh
+export LD_LIBRARY_PATH=$CATAPULT_ROOT/lib:$CATAPULT_ROOT/shared/lib:$LD_LIBRARY_PATH
+source "$ENV_SH"
+export LD_LIBRARY_PATH=$CONDA_PREFIX/lib:$LD_LIBRARY_PATH
+# The conda env's editable voyager_compiler points at the live tree; use
+# the checked-out compiler instead.
+export PYTHONPATH=$VOY/voyager-compiler/src
+
+# Sphinx run environment (CLAUDE.md) and the SphinxConfig accelerator
+# parameters (build/configs/SphinxConfig/config.sh as of 2026-09-17).
+export MEMORY_SUFFIX=u_ram_core.memory BANK_WIDTH=32 MACRO_WIDTH=16
+export SCRATCHPAD_SIZE=2097152 NUM_BANKS=16 SCRATCHPAD_OFFSET=262144
+export CLOCK_PERIOD=0.9 VOYAGER_INT_ID=1 LINKER_SCRIPT=../htif.ld
+export CONV2D_IM2COL=1
+unset MACRO_DEPTH
+export DATATYPE=MXNF4 IC_DIMENSION=64 OC_DIMENSION=64
+export INPUT_BUFFER_SIZE=512 WEIGHT_BUFFER_SIZE=576 ACCUM_BUFFER_SIZE=256
+export DOUBLE_BUFFERED_ACCUM_BUFFER=true SUPPORT_MVM=true SUPPORT_SPMM=true
+export BUILD_DIR
+
+# What run_voyager.py --jtag-mode full exports for the emitter.
+export JTAG_SIM=1 SIMS=gold,accelerator PROJECT_ROOT=$VOY
+export CODEGEN_DIR=test/compiler SPDLOG_LEVEL=DEBUG
+export SOC_MEM_OFFSET=262144 CACHE_SIZE=917504
+export EXTRA_SIM_CXXFLAGS="-DMXNF4 -DIC_DIMENSION=64 -DOC_DIMENSION=64 \
+-DINPUT_BUFFER_SIZE=512 -DWEIGHT_BUFFER_SIZE=576 -DACCUM_BUFFER_SIZE=256 \
+-DDOUBLE_BUFFERED_ACCUM_BUFFER=true -DSUPPORT_MVM=true -DSUPPORT_SPMM=true \
+-DCLOCK_PERIOD=0.9"
+
+# Layers the kit holds: what --uniquify_layers --skip_layers selects
+# (regression_common.add_layers), split by firmware.py's rule: a layer whose
+# layers.txt end op is async_wait_* stores every tile from one slot and is
+# emitted at MAX_TILES=1, the rest at MAX_TILES=2. Prints "<two> <one>".
+layer_sets() {
+    (cd "$VOY" && python - "$1" <<'EOF'
+import contextlib, io, json, os, sys
+from regression_common import add_layers, get_skip_layers
+net = sys.argv[1]
+rules = json.load(open("ci_skip_rules.json"))
+skip = get_skip_layers(rules, net, "MXNF4", "rtl", 64)
+layers, counts, tiles = {}, {}, {}
+with contextlib.redirect_stdout(io.StringIO()):
+    add_layers(net, layers, counts, tiles, True, skip,
+               codegen_root="test/compiler", datatype="MXNF4")
+sync = set()
+for line in open(f"test/compiler/networks/{net}/MXNF4/layers.txt"):
+    f = line.split()
+    if len(f) == 5 and f[2].startswith("async_wait"):
+        sync.add(f[0])
+two = [l for l in layers[net] if l not in sync]
+one = [l for l in layers[net] if l in sync]
+print(",".join(two), ",".join(one))
+EOF
+    )
+}
+
+emit_and_link() {  # <net> <max_tiles> <comma-separated layers>
+    local net=$1 tiles=$2 tests=$3
+    [ -z "$tests" ] && return 0
+    MAX_TILES=$tiles NETWORK=$net TESTS=$tests \
+        make -C "$VOY/test/soc" GenerateSoCBinaries || true
+    local flags="-DSUPPRESS_PRINTF -DNO_TESTBENCH -DVOYAGER_INT_ID=1"
+    for layer in ${tests//,/ }; do
+        if [ ! -f "$VOY/test/soc/firmware/networks/$net/$CFG/$layer.c" ]; then
+            echo "NOT EMITTED: $net $layer"
+            continue
+        fi
+        MAX_TILES=$tiles make -C "$WT/tests/voyager" "EXTRA_CFLAGS=$flags" \
+            "networks/$net/$CFG/$layer.riscv" || echo "LINK FAILED: $layer"
+    done
+}
+
+case $1 in
+compile)
+    cd "$VOY" && CLOCK_PERIOD=1.0 NETWORK=$2 make network-proto
+    git -C "$VOY/voyager-compiler" describe --always --dirty \
+        > "$VOY/test/compiler/networks/$2/MXNF4/compiler.txt"
+    ;;
+emit)
+    if [ "$2" = power ]; then export POWER_LOOP=1; else unset POWER_LOOP; fi
+    read -r two one <<< "$(layer_sets "$3")"
+    echo "two-tile: $two"
+    echo "one-tile: ${one:-}"
+    emit_and_link "$3" 2 "$two"
+    emit_and_link "$3" 1 "${one:-}"
+    ;;
+esac
diff --git a/sphinx/hello.gdb b/sphinx/hello.gdb
