index 0000000..4314c30
--- /dev/null
+++ b/sphinx/firmware/firmware.py
@@ -0,0 +1,295 @@
+#!/usr/bin/env python3
+"""The chip firmware kits, from compile to zip.
+
+    python sphinx/firmware/firmware.py all                both kinds for the twelve networks, then zip
+    python sphinx/firmware/firmware.py graded [net...]    run-once firmware   -> kits/graded/
+    python sphinx/firmware/firmware.py power  [net...]    POWER_LOOP firmware -> kits/power/
+    python sphinx/firmware/firmware.py pack               kits/sphinx-tests.zip and kits/sphinx-power.zip
+    python sphinx/firmware/firmware.py layers <net>       the layers a kit holds, and their MAX_TILES
+
+run_voyager.py does the work, as for a full-mode JTAG simulation but stopping
+after the link (--build-only): every layer --uniquify_layers --skip_layers
+would run is emitted and linked at MAX_TILES=2, then the layers whose tiles
+all store from one scratchpad slot again at MAX_TILES=1 (a readback keeps
+only their last tile). A network with no model.txt under
+test/compiler/networks/ is compiled first through codegen.mk, at
+CLOCK_PERIOD=1.0 so the params are priced at 1 GHz while the emitter and RTL
+stay at the 0.9 ns tapeout clock; one that exists is used as it is, so move
+it aside to recompile.
+
+Both kinds land on the same paths under test/soc/firmware/networks/, so each
+run copies what the chip needs into kits/<kind>/ before the other kind can
+overwrite it, after checking every ELF is the kind it claims: a graded main
+returns, a POWER_LOOP main never does and has no ret (243 graded and 151
+power ELFs checked, 2026-09-15). pack zips those trees and nothing else.
+
+The EDA modules and the conda env come from env.sh beside this file; the
+script re-runs itself under it, so a plain ssh shell is enough. Logs:
+sims/vcs/logs/firmware-<kind>.log, firmware-compile-<net>.log, and the
+regression_results folder each run_voyager.py call names.
+"""
+import argparse
+import contextlib
+import io
+import json
+import os
+import re
+import shutil
+import subprocess
+import sys
+import time
+import zipfile
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent
+VOY = HERE.parents[1]                      # generators/voyager
+SIMS = VOY.parents[1] / "sims" / "vcs"
+LOGS = SIMS / "logs"
+KITS = HERE / "kits"
+
+NETWORKS = [
+    "llama_prefill", "llama_prefill_mp", "llama_prefill_spmm", "llama_decode", "llama_decode_kivi",
+    "llama2_7b_prefill", "llama2_7b_verify", "llama2_7b_decode_kivi",
+    "amd135m_prefill", "amd135m_decode_kivi", "qwama_decode_kivi", "llama31_8b_verify",
+]
+
+# What the Sphinx runs export (CLAUDE.md).
+SPHINX_ENV = {
+    "MEMORY_SUFFIX": "u_ram_core.memory", "BANK_WIDTH": "32", "MACRO_WIDTH": "16",
+    "SCRATCHPAD_SIZE": "2097152", "NUM_BANKS": "16", "SCRATCHPAD_OFFSET": "262144",
+    "CLOCK_PERIOD": "0.9", "VOYAGER_INT_ID": "1", "LINKER_SCRIPT": "../htif.ld",
+    "CONV2D_IM2COL": "1",
+}
+
+
+def under_environment():
+    """Re-run under env.sh (a bash file: module loads and conda) unless
+    already there; the second run sees FIRMWARE_ENV and carries on."""
+    if os.environ.get("FIRMWARE_ENV") == "1":
+        return
+    LOGS.mkdir(parents=True, exist_ok=True)
+    script = (f'source "{HERE}/env.sh" > "{LOGS}/firmware-env.log" 2>&1; '
+              f'exec python "$0" "$@"')
+    os.execvpe("bash", ["bash", "-c", script, __file__, *sys.argv[1:]],
+               {**os.environ, "FIRMWARE_ENV": "1"})
+
+
+def configure():
+    """Export the Sphinx run environment and the accelerator parameters the
+    RTL build recorded (codegen.mk needs them to compile); return the
+    firmware directory name they make up."""
+    os.environ.update(SPHINX_ENV)
+    os.environ.pop("MACRO_DEPTH", None)
+    for line in (VOY / "build/configs/SphinxConfig/config.sh").read_text().splitlines():
+        m = re.match(r"export\s+(\w+)=(.*)", line.strip())
+        if m:
+            os.environ[m.group(1)] = m.group(2).strip("'\"")
+    e = os.environ
+    return (f"{e['DATATYPE']}/{e['IC_DIMENSION']}x{e['OC_DIMENSION']}"
+            f"_{e['INPUT_BUFFER_SIZE']}x{e['WEIGHT_BUFFER_SIZE']}x{e['ACCUM_BUFFER_SIZE']}"
+            f"_{e['DOUBLE_BUFFERED_ACCUM_BUFFER']}_{e['SUPPORT_MVM']}_{e['SUPPORT_SPMM']}")
+
+
+def now():
+    return time.strftime("%H:%M:%S")
+
+
+def run(cmd, log, cwd=None, env=None, append=False):
+    """Run a command with its output in a log file; return the exit code."""
+    with open(log, "a" if append else "w") as f:
+        return subprocess.run(cmd, cwd=cwd, env=env, stdout=f, stderr=subprocess.STDOUT).returncode
+
+
+# --- compile -----------------------------------------------------------------
+
+def compile_dir(network):
+    return VOY / "test/compiler/networks" / network / os.environ["DATATYPE"]
+
+
+def compile_missing(networks):
+    """codegen.mk compiles a network whose model.txt is missing and leaves one
+    that exists alone, as run_voyager.py would; here at CLOCK_PERIOD=1.0,
+    since codegen.mk prices the params at 1/CLOCK_PERIOD."""
+    for net in networks:
+        out = compile_dir(net)
+        if (out / "model.txt").exists():
+            continue
+        print(f"compile {net} ({now()})", flush=True)
+        log = LOGS / f"firmware-compile-{net}.log"
+        rc = run(["make", "-C", str(VOY), "network-proto"], log,
+                 env={**os.environ, "CLOCK_PERIOD": "1.0", "NETWORK": net})
+        if rc != 0:
+            print(f"compile {net}: FAILED, see {log} and {out}/codegen.log")
+            tail = (out / "codegen.log").read_text(errors="replace").replace("\0", "").splitlines()[-3:]
+            print("\n".join("    " + t for t in tail))
+            return False
+        compiler = subprocess.run(["git", "-C", str(VOY / "voyager-compiler"), "describe", "--always", "--dirty"],
+                                  capture_output=True, text=True).stdout.strip()
+        (out / "compiler.txt").write_text(compiler + "\n")
+        layers = sum(1 for line in (out / "layers.txt").read_text().splitlines() if line.strip())
+        print(f"compile {net}: {layers} layers, compiler {compiler} ({now()})", flush=True)
+    return True
+
+
+# --- layers ------------------------------------------------------------------
+
+def layer_sets(network):
+    """(two, one): the layers run_voyager.py --uniquify_layers --skip_layers
+    would run, split by whether the tile loop ends in a synchronous wait
+    (end op async_wait_*): every tile of such a layer stores from one
+    scratchpad slot, so full JTAG mode keeps only the last one and they are
+    emitted at MAX_TILES=1; the rest at MAX_TILES=2."""
+    sys.path.insert(0, str(VOY))
+    from regression_common import add_layers, get_skip_layers  # noqa: E402
+    datatype = os.environ["DATATYPE"]
+    block = max(int(os.environ["IC_DIMENSION"]), int(os.environ["OC_DIMENSION"]))
+    rules = json.loads((VOY / "ci_skip_rules.json").read_text())
+    skip = get_skip_layers(rules, network, datatype, "rtl", block)
+    layers, counts, tiles = {}, {}, {}
+    with contextlib.redirect_stdout(io.StringIO()):
+        add_layers(network, layers, counts, tiles, True, skip,
+                   codegen_root=str(VOY / "test/compiler"), datatype=datatype)
+    sync = set()
+    for line in (compile_dir(network) / "layers.txt").read_text().splitlines():
+        fields = line.split()
+        if len(fields) == 5 and fields[2].startswith("async_wait"):
+            sync.add(fields[0])
+    two = [l for l in layers[network] if l not in sync]
+    one = [l for l in layers[network] if l in sync]
+    return two, one
+
+
+# --- emit --------------------------------------------------------------------
+
+def elf_kind(elf):
+    """graded or power, from the ELF itself: a graded main returns, a
+    POWER_LOOP main never does and so has no ret at all. (Where main's last
+    instruction lands is not a test: GCC parks cold blocks that end in a
+    backward jump after the epilogue of graded mains too.)"""
+    text = subprocess.run(["riscv64-unknown-elf-objdump", "-d", "--no-show-raw-insn", str(elf)],
+                          capture_output=True, text=True).stdout
+    in_main, rets = False, 0
+    for line in text.splitlines():
+        if re.match(r"^[0-9a-f]+ <main>:", line):
+            in_main = True
+        elif re.match(r"^[0-9a-f]+ <[^>]*>:$", line) and in_main:
+            break
+        elif in_main and line.endswith("\tret"):
+            rets += 1
+    return "graded" if rets else "power"
+
+
+def run_voyager(max_tiles, extra, log, append=False):
+    cmd = ["python", "run_voyager.py", "--config", "SphinxConfig", "--jtag-mode", "full",
+           "--build-only", *extra]
+    return run(cmd, log, cwd=SIMS, env={**os.environ, "MAX_TILES": str(max_tiles)}, append=append)
+
+
+def build(kind, networks, cfg):
+    """Emit and link through run_voyager.py, then stage into kits/<kind>."""
+    if not compile_missing(networks):
+        return False
+    if kind == "power":
+        os.environ["POWER_LOOP"] = "1"
+    else:
+        os.environ.pop("POWER_LOOP", None)
+    log = LOGS / f"firmware-{kind}.log"
+    start = time.time() - 1
+    print(f"{kind}: emitting and linking {' '.join(networks)} ({now()}), log {log}", flush=True)
+    if run_voyager(2, ["--models", ",".join(networks), "--uniquify_layers", "--skip_layers"], log) != 0:
+        print(f"{kind}: run_voyager.py failed, see {log}")
+        return False
+    sets = {net: layer_sets(net) for net in networks}
+    for net, (_, one) in sets.items():
+        if one and run_voyager(1, ["--models", net, "--tests", ",".join(one)], log, append=True) != 0:
+            print(f"{kind} {net}: the MAX_TILES=1 layers failed, see {log}")
+            return False
+
+    ok = True
+    for net, (two, one) in sets.items():
+        fw = VOY / "test/soc/firmware/networks" / net / cfg
+        kit = KITS / kind / "networks" / net / cfg
+        shutil.rmtree(kit, ignore_errors=True)
+        kit.mkdir(parents=True)
+        # layers.txt gives the chip-side scripts the program order of the layers.
+        shutil.copy(compile_dir(net) / "layers.txt", kit)
+        staged, dropped, wrong = 0, [], []
+        for layer in two + one:
+            elf = fw / f"{layer}.riscv"
+            # Fresh ELFs only: a layer the emitter dropped must not ship stale.
+            if not elf.exists() or elf.stat().st_mtime < start:
+                dropped.append(layer)
+                continue
+            if elf_kind(elf) != kind:
+                wrong.append(layer)
+                continue
+            shutil.copy(elf, kit)
+            if kind == "graded":
+                shutil.copy(fw / f"{layer}_scratchpad_dump.txt", kit)
+                for expected in fw.glob(f"{layer}_scratchpad_expected.bin.*"):
+                    shutil.copy(expected, kit)
+            staged += 1
+        print(f"{kind} {net}: {staged} layers in kits/{kind}, dropped={dropped} wrong-kind={wrong}", flush=True)
+        ok = ok and not wrong
+    for line in log.read_text(errors="replace").splitlines():
+        if "did not emit" in line:
+            print("    " + line)
+    return ok
+
+
+# --- pack --------------------------------------------------------------------
+
+def pack():
+    """Zip the staged trees, each with its chip-side script."""
+    for kind in ("graded", "power"):
+        tree = KITS / kind
+        if not (tree / "networks").is_dir():
+            print(f"pack: no kits/{kind} yet")
+            continue
+        script = "run_layers.py" if kind == "graded" else "run_power.py"
+        shutil.copy(HERE.parent / script, tree)
+        zip_path = KITS / ("sphinx-tests.zip" if kind == "graded" else "sphinx-power.zip")
+        with zipfile.ZipFile(zip_path, "w", zipfile.ZIP_DEFLATED) as z:
+            for path in sorted(p for p in tree.rglob("*") if p.is_file()):
+                z.write(path, path.relative_to(tree))
+        elfs = sum(1 for _ in (tree / "networks").rglob("*.riscv"))
+        networks = sum(1 for p in (tree / "networks").iterdir() if p.is_dir())
+        print(f"pack: {zip_path} ({zip_path.stat().st_size / 2**20:.0f} MB): "
+              f"{elfs} ELFs, {networks} networks")
+    return True
+
+
+# --- stages ------------------------------------------------------------------
+
+def main():
+    p = argparse.ArgumentParser(description=__doc__,
+                                formatter_class=argparse.RawDescriptionHelpFormatter)
+    p.add_argument("stage", choices=["all", "graded", "power", "pack", "layers"])
+    p.add_argument("networks", nargs="*", help="default: the twelve chip networks")
+    args = p.parse_args()
+    under_environment()
+    networks = args.networks or NETWORKS
+    LOGS.mkdir(parents=True, exist_ok=True)
+    KITS.mkdir(parents=True, exist_ok=True)
+    cfg = configure()
+
+    if args.stage == "layers":
+        for net in networks:
+            two, one = layer_sets(net)
+            for layer in two:
+                print(f"{net}  MAX_TILES=2  {layer}")
+            for layer in one:
+                print(f"{net}  MAX_TILES=1  {layer}")
+        return 0
+    if args.stage == "pack":
+        return 0 if pack() else 1
+    if args.stage in ("graded", "power"):
+        return 0 if build(args.stage, networks, cfg) else 1
+    ok = build("graded", networks, cfg)
+    ok = build("power", networks, cfg) and ok
+    ok = pack() and ok
+    return 0 if ok else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
